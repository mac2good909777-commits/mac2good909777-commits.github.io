---
import V4Base from '../layouts/V4Base.astro';
const PHONE = '0953-909-777';
const LINE_ID = '0953909777';
const FB_URL = 'https://www.facebook.com/industrial.realestate.notes';
---
<V4Base title="聯繫｜張現傑 × 睦聚地產" description="有土地、廠房相關問題，或想評估設廠、資產活化方向，都歡迎與現傑聯絡。">
  <section class="v2-cat-hero">
    <div class="v2-wrap v2-cat-hero__inner">
      <div class="v2-cat-hero__kicker">CONTACT</div>
      <h1 class="v2-cat-hero__title">聯繫</h1>
      <p class="v2-cat-hero__desc">
        有土地、廠房相關問題，或想評估設廠、資產活化方向，都歡迎與現傑聯絡。
      </p>
    </div>
  </section>

  <section class="v2-section">
    <div class="v2-wrap">

      <h2 style="margin-bottom:48px;">若您或身邊朋友有相關需求<br/>歡迎直接聯繫</h2>

      <div style="display:grid;grid-template-columns:1.3fr 1fr;gap:64px;align-items:start;">

        <!-- 左欄：聯繫列表 -->
        <div>
          <div style="display:flex;flex-direction:column;gap:0;">
            <a href={`tel:${PHONE.replace(/-/g,'')}`} style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid var(--v2-line);color:var(--v2-ink);text-decoration:none;">
              <div>
                <div style="font-weight:500;margin-bottom:4px;">手機</div>
                <div style="color:var(--v2-text-soft);">{PHONE}</div>
              </div>
              <span style="color:var(--v2-navy);">→</span>
            </a>
            <a href="https://line.me/ti/p/WqW34GMG5R" target="_blank" style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid var(--v2-line);color:var(--v2-ink);text-decoration:none;">
              <div>
                <div style="font-weight:500;margin-bottom:4px;">LINE（主要）</div>
                <div style="color:var(--v2-text-soft);">ID：{LINE_ID}　看到訊息會在上班時段內回覆</div>
              </div>
              <span style="color:var(--v2-navy);">→</span>
            </a>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid var(--v2-line);color:var(--v2-ink);">
              <div>
                <div style="font-weight:500;margin-bottom:4px;">關於</div>
                <div style="color:var(--v2-text-soft);"><a href="https://mac2good909777-commits.github.io/about-mac/" target="_blank" style="color:var(--v2-text-soft);text-decoration:none;">張現傑</a></div>
              </div>
              <span style="color:var(--v2-navy);">→</span>
            </div>
            <a href="/about/" style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid var(--v2-line);color:var(--v2-ink);text-decoration:none;">
              <div>
                <div style="font-weight:500;margin-bottom:4px;">關於</div>
                <div style="color:var(--v2-text-soft);">張現傑 × 睦聚地產</div>
              </div>
              <span style="color:var(--v2-navy);">→</span>
            </a>
            <a href={FB_URL} target="_blank" style="display:flex;justify-content:space-between;align-items:center;padding:24px 0;border-bottom:1px solid var(--v2-line);color:var(--v2-ink);text-decoration:none;">
              <div>
                <div style="font-weight:500;margin-bottom:4px;">Facebook</div>
                <div style="color:var(--v2-text-soft);">粉絲專頁「工業地產筆記」</div>
              </div>
              <span style="color:var(--v2-navy);">→</span>
            </a>
          </div>

          <p style="margin-top:36px;color:var(--v2-text-soft);font-size:13px;line-height:1.9;">
            張現傑 ｜ 工業不動產・設廠評估整合服務<br/>
            睦聚地產開發 ｜ 負責人<br/>
            台中・中部地區 ｜ 服務超過 17 年
          </p>
        </div>

        <!-- 右欄：QR Code + 按鈕 -->
        <div style="position:sticky;top:100px;">
          <div style="background:var(--v2-bg-cream);padding:36px 28px;text-align:center;border-radius:4px;margin-bottom:16px;">
            <div class="v2-section__kicker" style="justify-content:center;display:inline-flex;margin-bottom:16px;">LINE QR CODE</div>
            <img src="/images/about-qr.png" alt="張現傑 LINE QR Code（ID 0953909777）" style="width:180px;height:180px;margin:0 auto;display:block;object-fit:contain;background:#fff;"/>
            <div style="margin-top:14px;font-weight:500;font-size:14px;"><span style="color:var(--v2-navy);">張現傑</span><span style="color:var(--v2-ink);"> × 睦聚地產</span></div>
            <div style="color:var(--v2-text-soft);margin-top:4px;font-size:13px;">工業不動產市場觀察・產業資訊分析</div>
          </div>

          <div style="display:flex;flex-direction:column;gap:10px;">
            <a href="https://line.me/ti/p/WqW34GMG5R" target="_blank" style="display:flex;align-items:center;justify-content:center;gap:8px;background:#06C755;color:#fff;font-weight:600;padding:14px;border-radius:8px;text-decoration:none;font-size:15px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M12 2C6.48 2 2 6.03 2 11c0 4.03 2.77 7.45 6.6 8.72L8 22l3.06-1.56C11.36 20.47 11.68 20.5 12 20.5c5.52 0 10-4.03 10-9S17.52 2 12 2z"/></svg>
              直接加 LINE 聯繫
            </a>
            <a href={`tel:${PHONE.replace(/-/g,'')}`} style="display:flex;align-items:center;justify-content:center;gap:8px;color:var(--v2-ink);font-weight:500;padding:14px;border-radius:8px;text-decoration:none;font-size:15px;border:1px solid var(--v2-line);">
              📞 有需求歡迎先聊聊
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>
</V4Base>